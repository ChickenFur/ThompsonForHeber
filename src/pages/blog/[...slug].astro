---
import { getCollection } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{post.data.title} | Christen Thompson for Heber City Council</title>
    <meta name="description" content={post.data.description} />
  </head>
  <body class="bg-gray-50 min-h-screen font-sans">
    <header class="bg-green-900 text-white py-6 shadow">
      <div
        class="container mx-auto flex flex-col md:flex-row items-center justify-between px-4"
      >
        <h1 class="text-3xl font-bold">
          <a href="/" class="hover:underline"
            >Christen Thompson for Heber City Council</a
          >
        </h1>
        <nav class="mt-4 md:mt-0">
          <a href="/" class="mr-6 hover:underline">Home</a>
          <a href="/about" class="mr-6 hover:underline">About</a>
          <a href="/blog" class="mr-6 hover:underline">Blog</a>
          <a href="/donate" class="hover:underline">Donate</a>
        </nav>
      </div>
    </header>
    <main class="container mx-auto px-4 py-10 max-w-3xl">
      <article class="bg-white rounded-lg shadow-lg p-8">
        <header class="mb-8">
          <h1 class="text-3xl font-bold mb-2">{post.data.title}</h1>
          <time class="text-gray-600"
            >{
              post.data.pubDate.toLocaleDateString('en-US', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })
            }</time
          >
        </header>

        <div class="prose prose-lg max-w-none">
          <Content />
        </div>

        <div class="mt-8 pt-6 border-t border-gray-200">
          <a href="/blog" class="text-green-700 hover:underline"
            >← Back to Blog</a
          >
        </div>
      </article>
    </main>
    <footer class="bg-green-900 text-white py-4 mt-10 text-center">
      &copy; 2025 Christen Thompson for Heber City Council
    </footer>
  </body>
</html>

