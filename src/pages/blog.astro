---
import { getCollection } from 'astro:content';
import '../styles/global.css';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Blog | Christen Thompson for Heber City Council</title>
  </head>
  <body class="bg-gray-50 min-h-screen font-sans">
    <header class="bg-green-900 text-white py-6 shadow">
      <div
        class="container mx-auto flex flex-col md:flex-row items-center justify-between px-4"
      >
        <h1 class="text-3xl font-bold">
          <a href="/" class="hover:underline"
            >Christen Thompson for Heber City Council</a
          >
        </h1>
        <nav class="mt-4 md:mt-0">
          <a href="/" class="mr-6 hover:underline">Home</a>
          <a href="/about" class="mr-6 hover:underline">About</a>
          <a href="/blog" class="mr-6 hover:underline">Blog</a>
          <a href="/donate" class="hover:underline">Donate</a>
        </nav>
      </div>
    </header>
    <main class="container mx-auto px-4 py-10 max-w-3xl">
      <h2 class="text-2xl font-semibold mb-8">Blog</h2>
      <div class="space-y-6">
        {
          posts.map(post => (
            <article class="bg-white rounded-lg shadow p-6">
              <div class="flex flex-col md:flex-row gap-4">
                {post.data.heroImage && (
                  <div class="md:w-1/3 flex-shrink-0">
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      class="w-full h-48 md:h-32 object-cover rounded-lg"
                    />
                  </div>
                )}
                <div class="md:flex-1">
                  <h3 class="text-xl font-bold mb-2">
                    <a
                      href={`/blog/${post.slug}`}
                      class="text-green-700 hover:underline"
                    >
                      {post.data.title}
                    </a>
                  </h3>
                  <time class="text-gray-600 text-sm">
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      weekday: 'long',
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                  <p class="mt-3 text-gray-700">{post.data.description}</p>
                  <a
                    href={`/blog/${post.slug}`}
                    class="inline-block mt-3 text-green-700 hover:underline"
                  >
                    Read more →
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </main>
    <footer class="bg-green-900 text-white py-4 mt-10 text-center">
      &copy; 2025 Christen Thompson for Heber City Council
    </footer>
  </body>
</html>
